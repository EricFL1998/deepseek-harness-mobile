{
  "name": "dsh-plugin-demo",
  "version": "0.1.0",
  "description": "DSH SDK 的官方示例 JS 插件：与 samples/demo-native 伴生 APK 配对，演示 Host RPC、原生事件回传与全部原生落点。纯虚构演示，不访问网络、不读写账号。",
  "license": "MIT",
  "author": "DSH Mobile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricFL1998/deepseek-harness-mobile.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "demo",
    "native-ui",
    "sdk-sample"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "native": {
      "pluginId": "demo.native-ui",
      "name": "Demo 插件",
      "apiVersion": 1,
      "minAppVersion": 12,
      "capabilities": [
        "openUrl",
        "storage"
      ],
      "storeUrl": "https://github.com/EricFL1998/deepseek-harness-mobile"
    }
  }
}
