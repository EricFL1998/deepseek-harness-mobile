    <string name="perm_desc_read_only">只能查看工作区和运行安全检查，不能修改文件</string>
    <string name="perm_desc_workspace_write">可在工作区内创建、编辑和修改文件</string>
    <string name="perm_desc_danger_full_access">无沙箱运行；减少确认步骤，可直接修改文件或执行外部命令</string>
